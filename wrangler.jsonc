{
    // matthewd.org — Hugo + Pagefind, served as Workers static assets.
    //
    // Same pattern as mlaify.io (mlaify/mlaify.github.io): no `main` and no Worker
    // script, so requests are served entirely by Cloudflare's asset worker — no
    // Worker invocation, no per-request cost. Add `main` only if this site ever
    // needs server-side logic.
    //
    // Deployed only by .github/workflows/deploy.yml after the operator approves the
    // `production` environment. See README.md "Deploy".
    "name": "matthewd-org",
    "compatibility_date": "2026-07-28",

    "assets": {
        "directory": "./public",

        // Hugo emits public/<path>/index.html, so /writing must redirect to /writing/.
        "html_handling": "auto-trailing-slash",

        // Serve Hugo's public/404.html with a real 404 status. Must NOT be
        // "single-page-application" — that would return 200 for every missing path.
        "not_found_handling": "404-page"
    },

    // Apex custom domain only. `wrangler deploy` replaces any domains attached in
    // the dashboard, so every hostname this Worker serves must be listed here.
    // `www` is intentionally absent: it should 301 to the apex with a Cloudflare
    // Redirect Rule, not be a second custom domain.
    "routes": [
        {
            "pattern": "matthewd.org",
            "custom_domain": true
        }
    ],

    // Reachable only at its custom domain: no <name>.workers.dev duplicate for
    // crawlers, and no public preview URLs.
    "workers_dev": false,
    "preview_urls": false,

    "observability": {
        "enabled": true
    }
}
