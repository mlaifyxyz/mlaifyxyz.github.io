# Response headers for Workers static assets.
#
# Hugo copies static/ verbatim into public/, so this lands at public/_headers,
# where Cloudflare reads it at deploy time. It is not itself served.
#
# This is the only place these headers are set. If a Cloudflare Transform Rule
# also sets any of them, remove one side — duplicated security headers are worse
# than none. scripts/check-build.sh fails the build if this file is missing.

/
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml", </index.xml>; rel="alternate"; type="application/rss+xml"; title="matthewd.org"

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# Hugo fingerprints these, so the filename changes whenever the content does.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind output is NOT fingerprinted; long-caching it would serve a stale index.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate
